{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meshflare-demo",
  "main": "server/demo-worker.ts",
  "compatibility_date": "2026-07-24",
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "DEMO_MODE": "true"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
